    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.4",
    "react-i18next": "^14.0.1",
    "react-router-dom": "^6.21.1",
    "sirv": "^2.0.4",
    "tailwindcss": "^3.4.1"
  },
